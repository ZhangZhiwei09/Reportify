<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="reportify-renderer" content="{{ renderer_id }}">
<meta name="reportify-report-id" content="{{ report_id }}">
<title>{{ title }}</title>
<style>
  :root { color-scheme: light; }
  body { font-family: -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif;
         margin: 0; background: #f6f7f9; color: #1f2328; line-height: 1.6; }
  main { max-width: 1080px; margin: 0 auto; padding: 28px 24px 48px; }
  h1 { font-size: 26px; margin: 0 0 6px; }
  h2 { font-size: 18px; margin: 32px 0 14px; padding-bottom: 6px; border-bottom: 1px solid #e3e6ea; }
  h3 { font-size: 15px; margin: 0 0 10px; }
  .summary { color: #495057; margin: 0 0 4px; }
  .meta { color: #6b7280; font-size: 12px; }
  .card { background: #fff; border: 1px solid #e3e6ea; border-radius: 10px; padding: 16px; margin: 14px 0; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .kpi-value { font-size: 30px; font-weight: 600; }
  .kpi-label { color: #57606a; font-size: 14px; }
  .chart { width: 100%; height: 360px; }
  .chart-fallback { margin-top: 10px; font-size: 13px; color: #57606a; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #eef0f3; }
  th { color: #57606a; font-weight: 600; font-size: 12px; text-transform: uppercase; }
  .lineage { font-size: 12px; color: #495057; }
  .lineage code { background: #f1f3f5; padding: 1px 5px; border-radius: 4px; word-break: break-all; }
  .text-block { white-space: pre-wrap; }
  footer { margin-top: 36px; color: #6b7280; font-size: 12px; }
</style>
</head>
<body data-renderer="{{ renderer_id }}">
<main>
  <h1>{{ title }}</h1>
  {% if summary %}<p class="summary">{{ summary }}</p>{% endif %}
  <p class="meta">
    {{ generated_at.isoformat() }}
    {% if template_name %} · 模板 <code>{{ template_name }}</code>{% endif %}
  </p>

  {% for section in sections %}
  <section id="{{ section.id }}">
    <h2>{{ section.title }}</h2>
    {% set kpis = section.blocks | selectattr("type", "equalto", "kpi") | list %}
    {% if kpis %}
    <div class="kpis">
      {% for block in kpis %}
      <div class="card">
        <div class="kpi-label">{{ block.label }}</div>
        <div class="kpi-value">{{ block.value }}{% if block.unit %} <small>{{ block.unit }}</small>{% endif %}</div>
        <div class="meta">口径：{{ block.definition }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% for block in section.blocks %}
      {% if block.type == "chart" %}
      <div class="card">
        <h3>{{ block.title }}</h3>
        <div class="chart" id="{{ block.chart_id }}" data-chart="{{ block.chart_id }}"></div>
        <script type="application/json" id="{{ block.chart_id }}-option">{{ block.option_json | safe }}</script>
        <p class="meta">口径：{{ block.definition }}</p>
        <details class="chart-fallback">
          <summary>图表数据（无脚本环境时查看）</summary>
          <table>
            <thead>
              <tr>
                <th>{{ block.x_label }}</th>
                {% for series in block.series %}<th>{{ series.name }}</th>{% endfor %}
              </tr>
            </thead>
            <tbody>
            {% for index in range(block.series[0].points | length) %}
              <tr>
                <td>{{ block.series[0].points[index].x }}</td>
                {% for series in block.series %}
                <td>{{ "" if series.points[index].y is none else series.points[index].y }}</td>
                {% endfor %}
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </details>
      </div>
      {% elif block.type == "table" %}
      <div class="card">
        <h3>{{ block.title }}</h3>
        <table>
          <thead><tr>{% for column in block.columns %}<th>{{ column }}</th>{% endfor %}</tr></thead>
          <tbody>
          {% for row in block.rows %}
            <tr>{% for cell in row %}<td>{{ "" if cell is none else cell }}</td>{% endfor %}</tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% elif block.type == "text" %}
      <div class="card"><p class="text-block">{{ block.text }}</p></div>
      {% endif %}
    {% endfor %}
  </section>
  {% endfor %}

  <section id="lineage">
    <h2>数据来源与口径</h2>
    {% for snapshot in lineage.snapshots %}
    <div class="card lineage">
      <div><strong>snapshot</strong> <code>{{ snapshot.id }}</code> · 用途 {{ snapshot.purpose }} · 行数 {{ snapshot.row_count }}</div>
      <div><strong>sql</strong> <code>{{ snapshot.sql }}</code></div>
      <div><strong>params</strong> <code>{{ snapshot.params }}</code></div>
      <div><strong>executed_at</strong> {{ snapshot.executed_at }}</div>
    </div>
    {% else %}
    <p class="meta">无查询快照引用。</p>
    {% endfor %}
  </section>

  <footer>Reportify · renderer {{ renderer_id }} · report {{ report_id }}</footer>
</main>

<script>{{ echarts_js | safe }}</script>
<script>
(function () {
  "use strict";
  function init() {
    if (typeof echarts === "undefined") {
      return;
    }
    var nodes = document.querySelectorAll("[data-chart]");
    for (var index = 0; index < nodes.length; index += 1) {
      var node = nodes[index];
      var source = document.getElementById(node.getAttribute("data-chart") + "-option");
      if (!source) {
        continue;
      }
      try {
        var option = JSON.parse(source.textContent);
        var chart = echarts.init(node);
        chart.setOption(option);
        window.addEventListener("resize", function () { chart.resize(); });
      } catch (error) {
        node.textContent = "图表渲染失败：" + error.message;
      }
    }
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>
</body>
</html>
