REPORTIFY_APP_ENV=dev
REPORTIFY_HOST=127.0.0.1
REPORTIFY_PORT=8000
REPORTIFY_LOG_LEVEL=INFO
REPORTIFY_DATABASE_URL=postgresql+asyncpg://reportify:reportify@127.0.0.1:5432/reportify
REPORTIFY_REDIS_URL=redis://127.0.0.1:6379/0
REPORTIFY_WORKSPACE_DIR=./workspace
REPORTIFY_REPORTS_DIR=./reports
REPORTIFY_SECRET_KEY=dev-only-change-me
REPORTIFY_KEY_VERSION=1
# REPORTIFY_AUTH_TOKEN=

# Model access. Without a key the API still starts; runs fail with 503
# model_not_configured instead of silently degrading.
# REPORTIFY_DEEPSEEK_API_KEY=
REPORTIFY_DEEPSEEK_BASE_URL=https://api.deepseek.com
REPORTIFY_DEEPSEEK_MODEL=deepseek-flash

# Run budgets (docs/architecture/02-agent-runtime.md §9.1)
REPORTIFY_RUN_TIMEOUT_SECONDS=900
REPORTIFY_RUN_REQUEST_LIMIT=40
REPORTIFY_RUN_TOOL_CALLS_LIMIT=25
REPORTIFY_RUN_TOTAL_TOKENS_LIMIT=300000
REPORTIFY_RUN_TOOL_TIMEOUT_SECONDS=120
REPORTIFY_MAX_CONCURRENT_RUNS=4
REPORTIFY_INSTRUCTIONS_CHAR_BUDGET=28000
REPORTIFY_MAX_PROMPT_CHARS=20000

# MCP (Streamable HTTP only; stdio is disabled by design)
# Leave unset: loopback is allowed in dev/test and blocked in prod.
# REPORTIFY_SSRF_ALLOW_LOOPBACK=false
REPORTIFY_MCP_CONNECT_TIMEOUT_SECONDS=30
REPORTIFY_MCP_READ_TIMEOUT_SECONDS=60
REPORTIFY_MCP_PROBE_TIMEOUT_SECONDS=5
